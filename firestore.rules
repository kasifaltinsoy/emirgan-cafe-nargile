rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Bu uygulamada yalnızca Firebase Authentication ile giriş yapmış kullanıcı
    // ürün ve sipariş kayıtlarına erişebilir.
    match /products/{productId} {
      allow read, write: if request.auth != null;
    }

    match /orders/{orderId} {
      allow read, write: if request.auth != null;
    }

    // Diğer tüm koleksiyonlar kapalıdır.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
