rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /products/{productId} {
      allow read, write: if request.auth != null;
    }

    match /orders/{orderId} {
      allow read, write: if request.auth != null;
    }

    match /priceHistory/{historyId} {
      allow read, write: if request.auth != null;
    }

    match /days/{dayId} {
      allow read, write: if request.auth != null;
    }

    match /trash/{trashId} {
      allow read, write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
